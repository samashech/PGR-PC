{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Retro-X",
  "version": "0.1.0",
  "identifier": "com.samash.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Retro-X \u00b7 Personal Arcade",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "$APP_DATA/**",
          "$APP_CONFIG/**",
          "$APP_LOCAL_DATA/**",
          "**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
